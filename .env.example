PORT=3000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=https://task-tracker-by-vikas.netlify.app
NODE_ENV=development

# AI (optional). OpenRouter is used when OPENROUTER_API_KEY is set.
OPENROUTER_API_KEY=
# Model selection is automatic through openrouter/free; no model variable needed.

# Legacy: Gemini, used only when OPENROUTER_API_KEY is empty
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
